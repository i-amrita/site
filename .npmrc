# pnpm config — scoped to this project only.
# Real registry (no global Verdaccio drift).
registry=https://registry.npmjs.org/

# Auto-install peer deps (Astro + shadcn/ui need this).
auto-install-peers=true

# Public hoist keeps Astro integrations + shadcn/ui deps resolvable.
public-hoist-pattern[]=*astro*
public-hoist-pattern[]=@shadcn/*
public-hoist-pattern[]=shadcn

# Use frozen lockfile in CI; ignore scripts for transient deps.
strict-peer-dependencies=false
node-linker=isolated