{
  "name": "i-amrita",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist && node scripts/build-embeddings.ts",
    "preview": "astro preview --port 4322",
    "check": "astro check && tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test:e2e": "playwright test -c tests/playwright.config.ts",
    "audit:site": "astro build --config astro.audit.config.mjs",
    "audit:links": "static-link-sentinel dist --site-url https://amrita.nambiar.my",
    "deploy": "pnpm build && wrangler deploy",
    "intl-ai:fill": "intl-ai fill",
    "intl-ai:check": "intl-ai check",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@astrojs/mdx": "8.1.0",
    "@astrojs/react": "^7.1.0",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@huggingface/transformers": "^4.3.1",
    "@lucide/astro": "^1.58.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "7.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.58.0",
    "nuqs": "^2.10.2",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.14.0",
    "@casoon/astro-post-audit": "^0.9.1",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@iconify-json/ph": "^1.2.2",
    "@inlang/paraglide-js": "^2.29.0",
    "@inlang/plugin-message-format": "^4.5.4",
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro-pagefind": "^2.0.1",
    "intl-ai": "^0.7.0",
    "lefthook": "^2.2.2",
    "oxc-transform-react": "^0.145.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "pagefind": "^1.5.2",
    "satori": "^0.62.0",
    "static-link-sentinel": "^1.1.1",
    "typescript": "^6.0.3",
    "unplugin-icons": "^24.0.0",
    "uqr": "^0.1.3",
    "wrangler": "^4.151.1"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.14.0"
}
