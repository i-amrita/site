---
import { m } from '@/lib/i18n';
---

<section class="flex flex-col items-center text-center">
  <h1 class="rise font-display text-5xl leading-[52px] font-normal sm:text-6xl sm:leading-[60px]" style="--i:0">
    <span data-i18n="hero_greeting">{m.hero_greeting()}</span>
    <em class="text-brand underline decoration-brand/40 decoration-1 underline-offset-8">Amrita</em>
  </h1>
  <p class="rise mt-3 text-sm leading-5 text-muted-foreground" style="--i:1" data-i18n="hero_subtitle">{m.hero_subtitle()}</p>
</section>
