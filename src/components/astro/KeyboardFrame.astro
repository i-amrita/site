---
import { Keyboard } from '@/components/react/Keyboard/Keyboard';
---

<!-- Reserves the real pad height (chassis only: 14 + 3x56 + 2x10 + 14 = 216) so hydration causes no layout shift. -->
<div class="rise mt-32 h-[216px] w-full" style="--i:4" data-keyboard-frame>
  <Keyboard client:idle />
</div>
