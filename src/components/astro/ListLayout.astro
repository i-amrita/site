---
import Base from '@/layouts/Base.astro';
import { m } from '@/lib/i18n';

interface Props {
  title: string;
  intro: string;
  description: string;
  mdHref: string;
  /** Narrow reading column (Log) instead of the wider list column (Work). */
  narrow?: boolean;
}
const { title, intro, description, mdHref, narrow = false } = Astro.props;
---

<Base title={`${title} | Amrita Nambiar`} description={description} mdHref={mdHref}>
  <main id="main" class:list={['mx-auto flex flex-col gap-6 px-6 py-12', narrow ? 'max-w-2xl' : 'max-w-3xl']}>
    <header class="flex flex-col gap-3">
      <a href="/" class="text-sm text-muted-foreground hover:text-brand">&larr; {m.nav_home()}</a>
      <h1 class="font-display text-4xl">{title}</h1>
      <p class="text-muted-foreground">{intro}</p>
    </header>
    <slot />
  </main>
</Base>
