---
import { NavbarActions } from '@/components/react/NavbarActions';
import { m } from '@/lib/i18n';
---

<header class="sticky top-0 z-40 flex justify-center px-4">
  <nav
    class="mt-3 flex h-9 w-max max-w-full items-center rounded-full bg-surface/80 px-1.5 shadow-[0_12px_32px_-12px_rgb(28_16_18/0.25)] ring-1 ring-fg/5 backdrop-blur"
    aria-label={m.nav_primary()}
    data-i18n-aria="nav_primary"
  >
    <NavbarActions pathname={Astro.url.pathname} client:idle />
  </nav>
</header>
