---
import { NavbarActions } from '@/components/react/NavbarActions';
import { SITE_NAME } from '@/lib/site';
---

<header class="px-4 pt-4 sm:px-6">
  <nav
    class="mx-auto flex max-w-5xl items-center justify-between rounded-card border border-border bg-surface-muted px-3 py-2"
    aria-label="Primary"
  >
    <NavbarActions side="left" client:load />
    <a href="/" class="font-display text-lg text-fg">{SITE_NAME}</a>
    <NavbarActions side="right" client:load />
  </nav>
</header>
