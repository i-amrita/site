---
import { render } from 'astro:content';

import { OverlaysRoot } from '@/components/react/Overlays';
import { getAllTags, getPosts, getProjects, getSingleton, toPostItem, toProjectItem } from '@/lib/content';

const [projectEntries, postEntries, tags, about] = await Promise.all([
  getProjects(),
  getPosts(),
  getAllTags(),
  getSingleton('about'),
]);
const projects = projectEntries.map(toProjectItem);
const posts = postEntries.map(toPostItem);
const AboutContent = about ? (await render(about)).Content : null;
---

<OverlaysRoot client:idle projects={projects} tags={tags} posts={posts}>
  {AboutContent && <div slot="about"><AboutContent /></div>}
</OverlaysRoot>
