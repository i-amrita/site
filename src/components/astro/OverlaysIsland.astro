---
import { render } from 'astro:content';

import { OverlaysRoot } from '@/components/react/Overlays';
import { getAllTags,
  getPosts,
  getProjects,
  getResearch,
  getSingleton,
  toPostItem,
  toProjectItem,
  toResearchItem,
} from '@/lib/content';

const [projectEntries, researchEntries, postEntries, tags, about] = await Promise.all([
  getProjects(),
  getResearch(),
  getPosts(),
  getAllTags(),
  getSingleton('about'),
]);
const projects = projectEntries.map(toProjectItem);
const research = researchEntries.map(toResearchItem);
const posts = postEntries.map(toPostItem);
const AboutContent = about ? (await render(about)).Content : null;
---

<OverlaysRoot client:idle projects={projects} research={research} tags={tags} posts={posts}>
  {AboutContent && <div slot="about"><AboutContent /></div>}
</OverlaysRoot>
