---
import { ArrowUpRight } from '@lucide/astro';

import TagList from '@/components/astro/TagList.astro';
import { formatPeriod, type ProjectEntry } from '@/lib/content';
import { tagSlug } from '@/lib/tags';

interface Props {
  project: ProjectEntry;
}
const { project } = Astro.props;
const d = project.data;
---

<article
  data-project-card
  data-tags={d.tags.map(tagSlug).join(' ')}
  class="group relative flex flex-col gap-3 rounded-card border border-border bg-surface p-5 transition-colors hover:border-brand"
>
  <header class="flex flex-col gap-1">
    <h2 class="font-display text-xl">
      <a href={`/projects/${project.id}`} class="after:absolute after:inset-0">{d.title}</a>
    </h2>
    <p class="text-sm text-muted-foreground">{d.role}, {d.org} · {formatPeriod(d.period)}</p>
  </header>
  <p>{d.summary}</p>
  <footer class="mt-auto flex items-end justify-between gap-2">
    <TagList tags={d.tags} />
    <ArrowUpRight class="size-4 shrink-0 text-muted-foreground transition-colors group-hover:text-brand" aria-hidden="true" />
  </footer>
</article>
