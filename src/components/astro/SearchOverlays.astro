---
import { SearchOverlays } from '@/components/react/SearchOverlays';
import { getProjects } from '@/lib/content';

const projects = (await getProjects()).map((p) => ({
  slug: p.id,
  title: p.data.title,
  org: p.data.org,
}));
const searchModal = Astro.url.pathname !== '/search';
---

<SearchOverlays client:idle projects={projects} searchModal={searchModal} />
