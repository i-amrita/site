---
import { href } from '@/lib/url-state';

interface Props {
  tags: string[];
  /** Link each tag to `/work?filter=<tag>`. */
  linked?: boolean;
}
const { tags, linked = false } = Astro.props;
const cls = 'rounded-key bg-surface-muted px-2 py-0.5 font-key text-xs text-muted-foreground';
---

{
  tags.length > 0 && (
    <ul class="flex flex-wrap gap-1.5">
      {tags.map((t) => (
        <li>
          {linked ? (
            <a href={href('/work', { filter: t })} class={`${cls} hover:text-fg`}>
              {t}
            </a>
          ) : (
            <span class={cls}>{t}</span>
          )}
        </li>
      ))}
    </ul>
  )
}
