---
import jakartaUrl from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';
import frauncesItalicUrl from '@fontsource/fraunces/files/fraunces-latin-400-italic.woff2?url';
import '@/styles/global.css';
import Footer from '@/components/astro/Footer.astro';
import Navbar from '@/components/astro/Navbar.astro';
import SearchOverlays from '@/components/astro/SearchOverlays.astro';
import { SPRITE_HASH } from '@/components/react/Keyboard/key-sprite';

interface Props {
  title: string;
  description?: string;
  /** Path of the markdown companion, e.g. `/about.md`. */
  mdHref?: string;
  /** Preload key-click sounds (home hero only). */
  preloadSounds?: boolean;
  /** schema.org JSON-LD object, serialized into the head. */
  jsonLd?: object;
  /** Path of the Open Graph image, e.g. `/og/default.png`. Defaults to the site card. */
  ogImage?: string;
  /** Open Graph type. */
  ogType?: 'website' | 'article';
  /** Set false for pages that have no canonical URL (404). */
  canonical?: boolean;
}
const {
  title,
  description: rawDescription = 'Amrita Nambiar: AI × community × human-centered design.',
  mdHref,
  preloadSounds = false,
  jsonLd,
  ogImage = '/og/default.png',
  ogType = 'website',
  canonical: withCanonical = true,
} = Astro.props;
// Search engines cut descriptions near 160 chars; trim at a word boundary.
const description =
  rawDescription.length <= 160 ? rawDescription : `${rawDescription.slice(0, 159).replace(/\s+\S*$/, '')}…`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Single format (AAC in `.m4a`, plays everywhere), so the preload is the request the app reuses.
const soundPreload = `(() => {
  const l = document.createElement('link');
  l.rel = 'preload';
  l.as = 'fetch';
  l.href = '/sounds/sprite-${SPRITE_HASH}.m4a';
  l.crossOrigin = 'anonymous';
  l.fetchPriority = 'low';
  document.head.append(l);
})();`;
const ogUrl = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f7f3ed" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1d1a1b" media="(prefers-color-scheme: dark)" />
    <slot name="head" />
    {
      // Hero name (Fraunces italic) and body (Jakarta) are first-paint text; preload to avoid late discovery.
      [jakartaUrl, frauncesItalicUrl].map((href) => (
        <link rel="preload" as="font" type="font/woff2" crossorigin="anonymous" href={href} />
      ))
    }
    <title>{title}</title>
    <meta name="description" content={description} />
    {withCanonical && <link rel="canonical" href={canonical} />}
    <meta property="og:site_name" content="Amrita Nambiar" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {withCanonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {mdHref && <link rel="alternate" type="text/markdown" href={mdHref} />}
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {preloadSounds && <script is:inline set:html={soundPreload} />}
    <script is:inline>
      // URL state first: ?theme=dark|light is applied before paint, no FOUC.
      const t = new URLSearchParams(location.search).get('theme');
      if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
      // i18n:start (locale before paint: html lang from ?locale=; all locales are LTR)
      const q = new URLSearchParams(location.search);
      // A locale chosen earlier is restored (replaceState, before islands hydrate) unless the URL already carries one.
      try {
        const saved = localStorage.getItem('locale');
        if (!q.has('locale') && saved && ['ms', 'hi', 'de', 'ml'].includes(saved)) {
          q.set('locale', saved);
          history.replaceState(history.state, '', location.pathname + '?' + q + location.hash);
        }
      } catch {}
      const l = q.get('locale');
      if (l && ['ms', 'hi', 'de', 'ml'].includes(l)) document.documentElement.lang = l;
      document.documentElement.dir = 'ltr';
      // i18n:end
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-key focus:bg-brand focus:px-4 focus:py-2 focus:text-brand-fg"
    >
      Skip to content
    </a>
    <slot name="header"><Navbar /></slot>
    <slot />
    <slot name="footer"><Footer /></slot>
    <SearchOverlays />
  </body>
</html>
