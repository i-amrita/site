---
import interUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import monoUrl from '@fontsource/jetbrains-mono/files/jetbrains-mono-latin-500-normal.woff2?url';
import frauncesUrl from '@fontsource/fraunces/files/fraunces-latin-600-normal.woff2?url';
import '@/styles/global.css';
import Footer from '@/components/astro/Footer.astro';
import Navbar from '@/components/astro/Navbar.astro';
import SearchOverlays from '@/components/astro/SearchOverlays.astro';

interface Props {
  title: string;
  description?: string;
  /** Path of the markdown companion, e.g. `/about.md`. */
  mdHref?: string;
  /** Preload key-click sounds (home hero only). */
  preloadSounds?: boolean;
  /** schema.org JSON-LD object, serialized into the head. */
  jsonLd?: object;
  /** Path of the Open Graph image, e.g. `/og/default.png`. Defaults to the site card. */
  ogImage?: string;
  /** Open Graph type. */
  ogType?: 'website' | 'article';
  /** Set false for pages that have no canonical URL (404). */
  canonical?: boolean;
}
const {
  title,
  description: rawDescription = 'Amrita Nambiar: AI × community × human-centered design.',
  mdHref,
  preloadSounds = false,
  jsonLd,
  ogImage = '/og/default.png',
  ogType = 'website',
  canonical: withCanonical = true,
} = Astro.props;
// Search engines cut descriptions near 160 chars; trim at a word boundary.
const description =
  rawDescription.length <= 160 ? rawDescription : `${rawDescription.slice(0, 159).replace(/\s+\S*$/, '')}…`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Same format choice as audio-preloader.ts, so the preload is the request the app reuses.
const soundPreload = `(() => {
  const ext = new Audio().canPlayType('audio/ogg; codecs="vorbis"') ? 'ogg' : 'm4a';
  for (const n of ['click-down', 'click-up']) {
    const l = document.createElement('link');
    l.rel = 'preload';
    l.as = 'fetch';
    l.href = '/sounds/' + n + '.' + ext;
    l.crossOrigin = 'anonymous';
    l.fetchPriority = 'low';
    document.head.append(l);
  }
})();`;
const ogUrl = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <slot name="head" />
    {
      // The keyboard legends use the mono face; without a preload it is discovered late and delays first paint.
      [interUrl, frauncesUrl, ...(preloadSounds ? [monoUrl] : [])].map((href) => (
        <link rel="preload" as="font" type="font/woff2" crossorigin="anonymous" href={href} />
      ))
    }
    <title>{title}</title>
    <meta name="description" content={description} />
    {withCanonical && <link rel="canonical" href={canonical} />}
    <meta property="og:site_name" content="Amrita Nambiar" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {withCanonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {mdHref && <link rel="alternate" type="text/markdown" href={mdHref} />}
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {preloadSounds && <script is:inline set:html={soundPreload} />}
    <script is:inline>
      // URL state first: ?theme=dark|light is applied before paint, no FOUC.
      const t = new URLSearchParams(location.search).get('theme');
      if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-key focus:bg-brand focus:px-4 focus:py-2 focus:text-brand-fg"
    >
      Skip to content
    </a>
    <slot name="header"><Navbar /></slot>
    <slot />
    <slot name="footer"><Footer /></slot>
    <SearchOverlays />
  </body>
</html>
