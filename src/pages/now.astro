---
import ProseLayout from '@/components/astro/ProseLayout.astro';
import { formatDate, getSingleton } from '@/lib/content';
import { render } from 'astro:content';

const entry = await getSingleton('now');
if (!entry) throw new Error('Missing src/content/now.mdx');
const { Content } = await render(entry);
const updated = entry.data.updatedDate;
---

<ProseLayout title={entry.data.title} description={entry.data.description} mdHref="/now.md">
  {updated && <p slot="meta" class="text-sm text-muted-foreground">Updated {formatDate(updated)}</p>}
  <Content />
</ProseLayout>
