---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';

import ProseLayout from '@/components/astro/ProseLayout.astro';
import TagList from '@/components/astro/TagList.astro';
import { formatDate, getPosts } from '@/lib/content';

export const getStaticPaths = (async () =>
  (await getPosts()).map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }))) satisfies GetStaticPaths;

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
---

<ProseLayout
  title={d.title}
  description={d.description}
  mdHref={`/posts/${entry.id}.md`}
  back={{ href: '/posts', label: 'All posts' }}
>
  <Fragment slot="meta">
    <time datetime={formatDate(d.pubDate)} class="text-sm text-muted-foreground">{formatDate(d.pubDate)}</time>
    <TagList tags={d.tags} />
  </Fragment>
  <Content />
</ProseLayout>
