---
import ListLayout from '@/components/astro/ListLayout.astro';
import { LogList } from '@/components/react/content-blocks';
import { getPosts, toPostItem } from '@/lib/content';
import { m } from '@/lib/i18n';

const posts = await getPosts();
---

<ListLayout
  title={m.nav_log()}
  intro={m.log_intro()}
  description="The log: notes and posts by Amrita Nambiar."
  mdHref="/posts/index.md"
  narrow
>
  {
    posts.length === 0 ? (
      <p class="text-muted-foreground">{m.log_empty()}</p>
    ) : (
      <LogList posts={posts.map(toPostItem)} />
    )
  }
</ListLayout>
