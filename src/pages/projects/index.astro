---
import ProjectCard from '@/components/astro/ProjectCard.astro';
import { ProjectFilter } from '@/components/react/ProjectFilter';
import Base from '@/layouts/Base.astro';
import { getAllTags, getProjects } from '@/lib/content';

const [projects, tags] = await Promise.all([getProjects(), getAllTags()]);
---

<Base title="Projects | Amrita Nambiar" description="Selected projects across AI, community and design." mdHref="/projects/index.md">
  <main id="main" class="mx-auto flex max-w-4xl flex-col gap-6 px-6 py-12">
    <h1 class="font-display text-4xl">Projects</h1>
    {tags.length > 0 && <ProjectFilter client:load tags={tags} />}
    {
      projects.length === 0 ? (
        <p class="text-muted-foreground">No projects yet.</p>
      ) : (
        <ul class="grid gap-4 sm:grid-cols-2">
          {projects.map((p) => (
            <li class="contents">
              <ProjectCard project={p} />
            </li>
          ))}
        </ul>
      )
    }
  </main>
</Base>
