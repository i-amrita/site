---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';

import ProseLayout from '@/components/astro/ProseLayout.astro';
import TagList from '@/components/astro/TagList.astro';
import { formatPeriod, getProjects } from '@/lib/content';

export const getStaticPaths = (async () =>
  (await getProjects()).map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }))) satisfies GetStaticPaths;

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
---

<ProseLayout
  kind="project"
  ogImage={`/og/work/${entry.id}.png`}
  title={d.title}
  description={d.summary}
  mdHref={`/work/${entry.id}.md`}
  eyebrow={d.role}
  back={{ href: '/work', label: 'All work' }}
>
  <Fragment slot="meta">
    <p class="text-muted-foreground">
      {d.org} · {formatPeriod(d.period)}{d.location ? ` · ${d.location}` : ''}
    </p>
    <p>{d.summary}</p>
    <TagList tags={d.tags} linked />
    {
      d.links.length > 0 && (
        <ul class="flex flex-wrap gap-4 text-sm">
          {d.links.map((l) => (
            <li>
              <a href={l.href} rel="noopener" class="text-brand underline hover:text-brand-hover">
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </Fragment>
  <Content />
</ProseLayout>
