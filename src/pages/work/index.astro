---
import ListLayout from '@/components/astro/ListLayout.astro';
import { ContentGroups } from '@/components/react/content-blocks';
import { ProjectFilter } from '@/components/react/ProjectFilter';
import {
  getAllTags,
  getProjects,
  getResearch,
  toProjectItem,
  toResearchItem,
} from '@/lib/content';
import { m } from '@/lib/i18n';

const [projects, research, tags] = await Promise.all([getProjects(), getResearch(), getAllTags()]);
const items = projects.map(toProjectItem);
---

<ListLayout
  title={m.nav_projects()}
  intro={m.work_intro()}
  description="Selected work, projects and research across AI, community and design."
  mdHref="/work/index.md"
>
  <ProjectFilter client:load tags={tags} />
  <div class="mt-6">
    <ContentGroups
      work={items.filter((p) => p.kind === 'work')}
      projects={items.filter((p) => p.kind === 'project')}
      research={research.map(toResearchItem)}
      show={null}
      headings
      labels={{
        work: m.kind_work(),
        projects: m.kind_projects(),
        research: m.kind_research(),
        empty: m.kind_empty(),
        readMore: m.projects_read_more(),
        readPaper: m.research_read(),
      }}
    />
  </div>
</ListLayout>
