---
import ListLayout from '@/components/astro/ListLayout.astro';
import { WorkList } from '@/components/react/content-blocks';
import { ProjectFilter } from '@/components/react/ProjectFilter';
import { getAllTags, getProjects, toProjectItem } from '@/lib/content';
import { m } from '@/lib/i18n';

const [projects, tags] = await Promise.all([getProjects(), getAllTags()]);
---

<ListLayout
  title={m.nav_projects()}
  intro={m.work_intro()}
  description="Selected work across AI, community and design."
  mdHref="/work/index.md"
>
  {tags.length > 0 && <ProjectFilter client:load tags={tags} />}
  {
    projects.length === 0 ? (
      <p class="text-muted-foreground">{m.projects_empty()}</p>
    ) : (
      <WorkList projects={projects.map(toProjectItem)} readMore={m.projects_read_more()} />
    )
  }
</ListLayout>
